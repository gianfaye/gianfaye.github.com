---
const social = [
  { name: 'github', label: 'GitHub', url: 'https://github.com/gianfaye' },
  { name: 'linkedin', label: 'LinkedIn', url: 'https://www.linkedin.com/in/gianfaye/' },
  { name: 'twitter', label: 'Twitter', url: 'https://twitter.com/gianfaye' },
  { name: 'stackoverflow', label: 'Stack Exchange', url: 'https://stackexchange.com/users/2642726/gian-faye?tab=accounts' },
  { name: 'mailto', label: 'Email', url: 'mailto:contact@gianfaye.com' },
];

const works = [
  { href: '/works/website/', label: 'Websites' },
  { href: '/works/landing-page/', label: 'Landing Pages' },
  { href: '/works/print/', label: 'Print' },
  { href: '/works/software/', label: 'Software' },
];

const topics = [
  { href: '/topics/web-development/', label: 'Web Development' },
  { href: '/topics/artificial-intelligence/', label: 'Artificial Intelligence' },
  { href: '/topics/internet-of-things/', label: 'Internet of Things' },
  { href: '/topics/augmented-reality/', label: 'Augmented Reality' },
  { href: '/topics/visual-design/', label: 'Visual Design' },
  { href: '/topics/business/', label: 'Business' },
  { href: '/topics/cybersecurity/', label: 'Cybersecurity' },
  { href: '/topics/machine-learning/', label: 'Machine Learning' },
  { href: '/topics/maker-culture/', label: 'Maker Culture' },
  { href: '/topics/data-analytics/', label: 'Data Analytics' },
  { href: '/topics/photography/', label: 'Photography' },
  { href: '/topics/personal-growth/', label: 'Personal Growth' },
];

const mainLeft = [
  { href: '/', label: 'Home' },
  { href: '/blog/', label: 'Blog' },
  { href: '/project/', label: 'Projects' },
];
const mainRight = [
  { href: '/about/', label: 'About' },
  { href: '/timeline/', label: 'Timeline' },
  { href: '/topics/', label: 'Topics' },
];
---

<footer class="site-footer">
  <div class="site-footer__top">
    <h2 class="site-footer__heading">Everything Else.</h2>

    <div class="site-footer__grid">
      <div class="site-footer__main">
        <ul>
          {mainLeft.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
        </ul>
        <ul>
          {mainRight.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
        </ul>
      </div>

      <div class="site-footer__columns">
        <div>
          <h3>Works</h3>
          <ul class="site-footer__sublist">
            {works.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
          </ul>
        </div>
        <div>
          <h3>Topics</h3>
          <ul class="site-footer__sublist site-footer__sublist--two">
            {topics.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
          </ul>
        </div>
      </div>
    </div>
  </div>

  <div class="site-footer__bottom">
    <ul class="site-footer__social" aria-label="Social links">
      {social.map((s) => (
        <li>
          <a
            href={s.url}
            target={s.name === 'mailto' ? undefined : '_blank'}
            rel={s.name === 'mailto' ? undefined : 'noopener nofollow'}
            aria-label={s.label}
            title={s.label}
          >
            {/* Verbatim SVGs from @gianfaye/gatsby-theme/src/icons/social.
             * Each icon ships with its own viewBox + intrinsic dimensions
             * — the original SocialIconContainer caps rendered width at
             * 16px via max-width, which we reproduce on the parent <a>. */}
            {s.name === 'github' && (
              <svg width="14" height="14" viewBox="0 0 14 14" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                <path fill-rule="evenodd" clip-rule="evenodd" d="M7 0C3.1325 0 0 3.21173 0 7.17706C0 10.3529 2.00375 13.0353 4.78625 13.9863C5.13625 14.0491 5.2675 13.8338 5.2675 13.6454C5.2675 13.4749 5.25875 12.9097 5.25875 12.3087C3.5 12.6406 3.045 11.8691 2.905 11.4653C2.82625 11.259 2.485 10.622 2.1875 10.4516C1.9425 10.317 1.5925 9.98508 2.17875 9.97611C2.73 9.96714 3.12375 10.4964 3.255 10.7118C3.885 11.7973 4.89125 11.4923 5.29375 11.3039C5.355 10.8374 5.53875 10.5234 5.74 10.3439C4.1825 10.1645 2.555 9.54549 2.555 6.80026C2.555 6.01976 2.82625 5.37382 3.2725 4.87143C3.2025 4.692 2.9575 3.95635 3.3425 2.96951C3.3425 2.96951 3.92875 2.78111 5.2675 3.70516C5.8275 3.54367 6.4225 3.46293 7.0175 3.46293C7.6125 3.46293 8.2075 3.54367 8.7675 3.70516C10.1063 2.77214 10.6925 2.96951 10.6925 2.96951C11.0775 3.95635 10.8325 4.692 10.7625 4.87143C11.2087 5.37382 11.48 6.01079 11.48 6.80026C11.48 9.55446 9.84375 10.1645 8.28625 10.3439C8.54 10.5682 8.75875 10.9988 8.75875 11.6717C8.75875 12.6316 8.75 13.4032 8.75 13.6454C8.75 13.8338 8.88125 14.0581 9.23125 13.9863C11.9963 13.0353 14 10.3439 14 7.17706C14 3.21173 10.8675 0 7 0Z" fill="currentColor"/>
              </svg>
            )}
            {s.name === 'linkedin' && (
              <svg width="14" height="14" viewBox="0 0 14 14" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                <path fill-rule="evenodd" clip-rule="evenodd" d="M3.59615 13.125H0.871552V4.36523H3.59615V13.125ZM2.24847 3.16406C1.81878 3.16406 1.44769 3.00781 1.13519 2.69531C0.822692 2.38281 0.666443 2.01171 0.666443 1.58203C0.666443 1.15234 0.822692 0.781248 1.13519 0.468749C1.44769 0.156249 1.81878 0 2.24847 0C2.67816 0 3.04925 0.156249 3.36175 0.468749C3.67425 0.781248 3.8305 1.15234 3.8305 1.58203C3.8305 2.01171 3.67425 2.38281 3.36175 2.69531C3.04925 3.00781 2.67816 3.16406 2.24847 3.16406ZM13.7915 13.125H11.0669V8.84765C11.0669 8.14452 11.0083 7.63671 10.8911 7.32421C10.6763 6.79687 10.2563 6.5332 9.63134 6.5332C9.00634 6.5332 8.56689 6.76757 8.31298 7.23632C8.11767 7.58788 8.02001 8.10546 8.02001 8.78905V13.125H5.32471V4.36523H7.93212V5.5664H7.96142C8.15673 5.17578 8.46923 4.85351 8.89892 4.59961C9.36767 4.28711 9.91454 4.13086 10.5395 4.13086C11.8091 4.13086 12.6977 4.53125 13.2055 5.33203C13.5962 5.97656 13.7915 6.97265 13.7915 8.3203V13.125Z" fill="currentColor"/>
              </svg>
            )}
            {s.name === 'twitter' && (
              <svg width="16" height="13" viewBox="0 0 16 13" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                <path fill-rule="evenodd" clip-rule="evenodd" d="M14.0658 2.34438C14.7013 1.96349 15.1892 1.3604 15.419 0.641811C14.8244 0.994439 14.1658 1.25056 13.4648 1.3886C12.9034 0.7905 12.1036 0.416748 11.2185 0.416748C9.51888 0.416748 8.14096 1.79461 8.14096 3.49411C8.14096 3.7353 8.16822 3.97019 8.22068 4.19542C5.66301 4.06708 3.39543 2.84191 1.8776 0.980064C1.6127 1.43458 1.46094 1.96322 1.46094 2.52719C1.46094 3.59485 2.00428 4.5368 2.83003 5.08865C2.32553 5.07268 1.85104 4.93425 1.43608 4.70376C1.43586 4.71659 1.43586 4.72949 1.43586 4.74244C1.43586 6.23349 2.49666 7.47732 3.90448 7.75999C3.64622 7.83033 3.37436 7.86792 3.09366 7.86792C2.89537 7.86792 2.70257 7.84866 2.51471 7.81272C2.90629 9.03537 4.0428 9.92509 5.38945 9.94994C4.33623 10.7753 3.00928 11.2673 1.56749 11.2673C1.31911 11.2673 1.07413 11.2528 0.833374 11.2243C2.19527 12.0975 3.81291 12.6069 5.55081 12.6069C11.2113 12.6069 14.3067 7.91763 14.3067 3.85096C14.3067 3.71753 14.3037 3.5848 14.2978 3.45285C14.899 3.01896 15.4208 2.47694 15.8334 1.8598C15.2815 2.10456 14.6884 2.26998 14.0658 2.34438Z" fill="currentColor"/>
              </svg>
            )}
            {s.name === 'stackoverflow' && (
              <svg width="15" height="15" viewBox="0 0 73.1 86.6" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                <path fill-rule="evenodd" clip-rule="evenodd" d="M61.8,78.9V55.7h7.7v30.9H0V55.7h7.7v23.2H61.8z" fill="currentColor"/>
                <path fill-rule="evenodd" clip-rule="evenodd" d="M16.2,53.5L54,61.4l1.6-7.6l-37.8-7.9L16.2,53.5z M21.2,35.5l35,16.3l3.2-7l-35-16.4 C24.4,28.4,21.2,35.5,21.2,35.5z M30.9,18.3L60.6,43l4.9-5.9L35.8,12.4C35.8,12.4,30.9,18.3,30.9,18.3z M50.1,0l-6.2,4.6l23,31 l6.2-4.6L50.1,0z M15.4,71.1H54v-7.7H15.4V71.1z" fill="currentColor"/>
              </svg>
            )}
            {s.name === 'mailto' && (
              <svg width="14" height="14" viewBox="0 0 512 512" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                <path fill-rule="evenodd" clip-rule="evenodd" d="M502.3 190.8c3.9-3.1 9.7-.2 9.7 4.7V400c0 26.5-21.5 48-48 48H48c-26.5 0-48-21.5-48-48V195.6c0-5 5.7-7.8 9.7-4.7 22.4 17.4 52.1 39.5 154.1 113.6 21.1 15.4 56.7 47.8 92.2 47.6 35.7.3 72-32.8 92.3-47.6 102-74.1 131.6-96.3 154-113.7zM256 320c23.2.4 56.6-29.2 73.4-41.4 132.7-96.3 142.8-104.7 173.4-128.7 5.8-4.5 9.2-11.5 9.2-18.9v-19c0-26.5-21.5-48-48-48H48C21.5 64 0 85.5 0 112v19c0 7.4 3.4 14.3 9.2 18.9 30.6 23.9 40.7 32.4 173.4 128.7 16.8 12.2 50.2 41.8 73.4 41.4z" fill="currentColor"/>
              </svg>
            )}
          </a>
        </li>
      ))}
    </ul>

    <p class="site-footer__copy">© 2010–{new Date().getFullYear()} Gian Faye Paguirigan</p>

    <ul class="site-footer__sublinks" aria-label="Site links">
      <li><a href="/privacy/">Privacy</a></li>
      <li><a href="/terms/">Terms of Use</a></li>
      <li><a href="/rss.xml">RSS</a></li>
    </ul>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--color-footer-bg);
    color: var(--color-footer-fg);
    margin-top: 4rem;
  }
  .site-footer a {
    color: inherit;
    text-decoration: none;
    transition: color 0.2s ease;
  }
  .site-footer a:hover { color: var(--color-accent); }

  .site-footer__top {
    max-width: 1220px;
    margin: 0 auto;
    padding: 3rem 4rem 0;
  }
  .site-footer__heading {
    font-family: var(--font-serif);
    font-weight: 400;
    font-size: clamp(2.25rem, 5vw, 3.75rem);
    letter-spacing: 0.02em;
    margin: 0 0 2rem;
  }
  .site-footer__grid {
    display: grid;
    grid-template-columns: 2fr 3fr;
    gap: 3rem;
    border-bottom: 1px solid var(--color-rule);
    padding-bottom: 3rem;
  }
  .site-footer__main {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.25rem;
  }
  .site-footer__main ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .site-footer__main a {
    display: block;
    font-family: var(--font-serif);
    font-size: 1.5rem;
    padding-bottom: 0.5rem;
    margin-bottom: 0.625rem;
    border-bottom: 2px solid currentColor;
  }
  .site-footer__columns {
    display: grid;
    grid-template-columns: 1fr 1.5fr;
    gap: 1.25rem;
  }
  .site-footer__columns h3 {
    font-family: var(--font-sans);
    font-size: 0.875rem;
    font-weight: 600;
    letter-spacing: 0.125em;
    text-transform: uppercase;
    margin: 0 0 1rem;
  }
  .site-footer__sublist {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .site-footer__sublist li {
    font-family: var(--font-serif);
    font-size: 1.125rem;
    margin-bottom: 0.625rem;
  }
  .site-footer__sublist--two {
    columns: 2;
    column-gap: 0.625rem;
  }

  .site-footer__bottom {
    max-width: 1220px;
    margin: 0 auto;
    padding: 2rem 4rem 2.5rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    flex-wrap: wrap;
  }
  /* Matches the original SocialLinks: each icon container caps at 16px
   * wide, separated by 3.2rem of left margin (3.2rem in their 10px-base
   * stylesheet ≈ 32px — preserving that absolute spacing here). */
  .site-footer__social {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    align-items: center;
  }
  .site-footer__social li + li { margin-left: 32px; }
  .site-footer__social a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    max-width: 16px;
    color: var(--color-footer-fg);
  }
  .site-footer__social a:hover { color: var(--color-accent); }
  .site-footer__copy {
    font-family: var(--font-sans);
    font-size: 0.75rem;
    letter-spacing: 0.125em;
    text-transform: uppercase;
    margin: 0;
  }
  .site-footer__sublinks {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    align-items: center;
    gap: 1rem;
  }
  .site-footer__sublinks a {
    font-family: var(--font-sans);
    font-size: 0.625rem;
    letter-spacing: 0.125em;
    text-transform: uppercase;
  }

  @media (max-width: 1024px) {
    .site-footer__top { padding: 2rem 1.5rem 0; }
    .site-footer__bottom {
      padding: 1.5rem;
      flex-direction: column;
      align-items: flex-start;
    }
    .site-footer__grid {
      grid-template-columns: 1fr;
      gap: 2rem;
    }
    .site-footer__columns { grid-template-columns: 1fr; }
  }
</style>
