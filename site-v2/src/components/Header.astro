---
import Logo from './Logo.astro';

const navItems = [
  { href: '/', label: 'Home' },
  { href: '/about/', label: 'About' },
  { href: '/project/', label: 'Projects' },
  { href: '/blog/', label: 'Blog' },
  { href: '/timeline/', label: 'Timeline' },
];

const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';
---

<header id="site-header" class="site-header">
  <div class="site-header__inner">
    <a href="/" class="site-header__logo" aria-label="Navigate back to the homepage">
      <Logo />
    </a>

    <nav class="site-header__nav" aria-label="Primary">
      <ul class="site-header__menu">
        {navItems.map((item) => {
          const itemPath = item.href.replace(/\/$/, '') || '/';
          const isActive = currentPath === itemPath;
          return (
            <li>
              <a href={item.href} class:list={['site-header__link', { active: isActive }]}>
                {item.label}
              </a>
            </li>
          );
        })}
      </ul>

      <button
        id="copy-email"
        class="site-header__icon-btn"
        type="button"
        aria-label="Copy my email to your clipboard"
        title="Copy my email to your clipboard"
      >
        {/* Verbatim from @gianfaye/gatsby-theme/src/icons/ui/MailtoMd.Icon.tsx
         * — the heavier solid envelope used in the header (the footer
         * mailto uses the same path at 14x14). */}
        <svg width="28" height="28" viewBox="0 0 512 512" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
          <path fill-rule="evenodd" clip-rule="evenodd" d="M502.3 190.8c3.9-3.1 9.7-.2 9.7 4.7V400c0 26.5-21.5 48-48 48H48c-26.5 0-48-21.5-48-48V195.6c0-5 5.7-7.8 9.7-4.7 22.4 17.4 52.1 39.5 154.1 113.6 21.1 15.4 56.7 47.8 92.2 47.6 35.7.3 72-32.8 92.3-47.6 102-74.1 131.6-96.3 154-113.7zM256 320c23.2.4 56.6-29.2 73.4-41.4 132.7-96.3 142.8-104.7 173.4-128.7 5.8-4.5 9.2-11.5 9.2-18.9v-19c0-26.5-21.5-48-48-48H48C21.5 64 0 85.5 0 112v19c0 7.4 3.4 14.3 9.2 18.9 30.6 23.9 40.7 32.4 173.4 128.7 16.8 12.2 50.2 41.8 73.4 41.4z" fill="currentColor"/>
        </svg>
        <span class="site-header__tooltip" data-state="idle">Email copied</span>
      </button>

      <button
        id="dark-mode-toggle"
        class="site-header__icon-btn site-header__toggle"
        type="button"
        aria-label="Activate dark mode"
        title="Activate dark mode"
      >
        <span class="moon-or-sun" aria-hidden="true"></span>
        <span class="moon-mask" aria-hidden="true"></span>
      </button>

      <button
        id="mobile-menu-toggle"
        class="site-header__hamburger"
        type="button"
        aria-label="Open menu"
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <span></span><span></span><span></span>
      </button>
    </nav>
  </div>

  <div id="mobile-menu" class="site-header__mobile" hidden>
    <ul>
      {navItems.map((item) => (
        <li><a href={item.href}>{item.label}</a></li>
      ))}
    </ul>
  </div>
</header>

<style>
  /* Two-tier container matches the original NavToolbar / NavContainer:
   * the outer .site-header carries the 40px horizontal padding so the
   * 1140px content area inside has no horizontal padding of its own.
   * On viewports wider than 1220px the inner centers; on narrower
   * viewports the 40px outer padding keeps content off the screen edges
   * without ever shrinking the usable content width below 1140px on a
   * wide enough screen. */
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    width: 100%;
    background: var(--color-bg);
    padding: 0 40px;
    transition: box-shadow 0.2s ease, background 0.25s ease;
  }
  .site-header.is-scrolled {
    box-shadow: 0 1px 0 var(--color-rule);
  }
  /* NavContainer: 100px top padding initially (the breathing room above
   * the menu on the unscrolled hero). When the sticky shadow kicks in
   * we collapse the top padding to 0 so the floating bar is compact —
   * mirrors the original `&.sticky > div { padding-top: 0 }` rule.
   * Smaller viewports drop the initial padding to 50px to match the
   * original mediaqueries.desktop_medium and short-screen overrides. */
  .site-header__inner {
    max-width: 1140px;
    margin: 0 auto;
    padding: 100px 0 0 0;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
    transition: padding-top 0.4s ease;
  }
  .site-header.is-scrolled .site-header__inner { padding-top: 0; }

  @media (max-width: 1280px) {
    .site-header__inner { padding-top: 50px; }
  }
  @media (max-height: 800px) {
    .site-header__inner { padding-top: 50px; }
  }

  .site-header__logo {
    display: flex;
    align-items: center;
    color: var(--color-fg);
  }
  /* Sticky logo collapses to 60px (80px height with 10px vertical padding
   * baked into the 250x82 viewBox) — matches the original
   * `&.sticky > div > a > div > svg { height: 80px; padding: 10px 0 }`. */
  .site-header.is-scrolled .site-header__logo :global(.logo) {
    width: 183px;
    height: 60px;
    transition: width 0.3s ease, height 0.3s ease;
  }
  .site-header__logo :global(.logo) {
    transition: width 0.3s ease, height 0.3s ease;
  }

  .site-header__nav {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }
  .site-header__menu {
    display: flex;
    align-items: center;
    gap: 0.25rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  /* Menu link styling copied verbatim from the original styled MenuLink
   * (Navigation.Header.tsx). Note the original has NO &.active rule —
   * the active item looks identical to inactive ones. Hover dims sibling
   * links to opacity 0.5; the hovered one stays at 1. No accent color
   * on hover or active — original keeps colors.primary throughout. */
  .site-header__link {
    display: inline-block;
    position: relative;
    padding: 20px;
    font-family: var(--font-sans);
    font-size: 12px;
    font-weight: 600;
    line-height: 1.32;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: var(--color-fg);
    transition: 0.4s;
  }
  .site-header__menu:hover .site-header__link { opacity: 0.5; }
  .site-header__menu .site-header__link:hover { opacity: 1; }

  /* Icon buttons (mailto, dark mode) */
  .site-header__icon-btn {
    position: relative;
    background: transparent;
    border: 0;
    padding: 0.5rem;
    margin-left: 0.5rem;
    color: var(--color-fg);
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
  }

  /* Tooltip on the email button after copy */
  .site-header__tooltip {
    position: absolute;
    padding: 5px 13px;
    background: rgba(0, 0, 0, 0.1);
    color: var(--color-fg);
    border-radius: 5px;
    font-family: var(--font-sans);
    font-size: 12px;
    bottom: -42px;
    right: -18px;
    opacity: 0;
    transform: translateY(0);
    transition: transform 0.3s ease-in-out, opacity 0.3s ease-in-out;
    pointer-events: none;
    white-space: nowrap;
  }
  :root.dark .site-header__tooltip {
    background: #000;
    color: #fff;
  }
  .site-header__tooltip::after {
    content: "";
    position: absolute;
    left: 50%;
    transform: translateX(-50%);
    top: -6px;
    width: 0;
    height: 0;
    border-left: 6px solid transparent;
    border-right: 6px solid transparent;
    border-bottom: 6px solid rgba(0, 0, 0, 0.1);
  }
  :root.dark .site-header__tooltip::after { border-bottom-color: #000; }
  .site-header__tooltip[data-state="copied"] {
    opacity: 1;
    transform: translateY(-3px);
  }

  /* Moon-to-sun morph — recreated from the original CSS in
   * Navigation.Header.tsx (MoonOrSun + MoonMask). The MoonOrSun is a
   * disc; in light mode it's a full circle with sun-rays projected
   * via box-shadow on its ::after pseudo. In dark mode the disc
   * shrinks and the ::before sibling ring (offset, masked by MoonMask
   * background-colored to the page) carves out a crescent. */
  .site-header__toggle .moon-or-sun {
    position: relative;
    display: block;
    width: 20px;
    height: 20px;
    border-radius: 50%;
    border: 2px solid var(--color-fg);
    background: var(--color-fg);
    transform: scale(1);
    transition: all 0.45s ease;
    overflow: hidden;
    top: -1px;
  }
  .site-header__toggle .moon-or-sun::before {
    content: "";
    position: absolute;
    right: -9px;
    top: -9px;
    height: 24px;
    width: 24px;
    border: 2px solid var(--color-fg);
    border-radius: 50%;
    transform: translate(0, 0);
    opacity: 1;
    transition: transform 0.45s ease;
  }
  .site-header__toggle .moon-or-sun::after {
    content: "";
    width: 8px;
    height: 8px;
    border-radius: 50%;
    margin: -4px 0 0 -4px;
    position: absolute;
    top: 50%;
    left: 50%;
    box-shadow:
      0 -23px 0 var(--color-fg),
      0 23px 0 var(--color-fg),
      23px 0 0 var(--color-fg),
      -23px 0 0 var(--color-fg),
      15px 15px 0 var(--color-fg),
      -15px 15px 0 var(--color-fg),
      15px -15px 0 var(--color-fg),
      -15px -15px 0 var(--color-fg);
    transform: scale(0);
    transition: all 0.35s ease;
  }
  .site-header__toggle .moon-mask {
    position: absolute;
    right: -1px;
    top: -8px;
    height: 24px;
    width: 24px;
    border-radius: 50%;
    border: 0;
    background: var(--color-bg);
    transform: translate(0, 0);
    opacity: 1;
    transition: background 0.25s ease, transform 0.45s ease;
  }
  /* Dark-mode state: disc shrinks, ring drifts away to reveal crescent,
   * sun rays slide into view, mask hides off-screen. */
  :root.dark .site-header__toggle .moon-or-sun {
    border-width: 4px;
    transform: scale(0.55);
    overflow: visible;
  }
  :root.dark .site-header__toggle .moon-or-sun::before {
    transform: translate(14px, -14px);
    opacity: 0;
  }
  :root.dark .site-header__toggle .moon-or-sun::after {
    transform: scale(1);
  }
  :root.dark .site-header__toggle .moon-mask {
    transform: translate(14px, -14px);
    opacity: 0;
  }

  /* Hamburger */
  .site-header__hamburger {
    background: transparent;
    border: 0;
    padding: 0.5rem;
    margin-left: 0.5rem;
    color: var(--color-fg);
    cursor: pointer;
    display: none;
    flex-direction: column;
    gap: 4px;
    width: 28px;
  }
  .site-header__hamburger span {
    display: block;
    width: 100%;
    height: 2px;
    background: var(--color-fg);
    transition: transform 0.2s ease, opacity 0.2s ease;
  }
  .site-header__hamburger[aria-expanded="true"] span:nth-child(1) {
    transform: translateY(6px) rotate(45deg);
  }
  .site-header__hamburger[aria-expanded="true"] span:nth-child(2) { opacity: 0; }
  .site-header__hamburger[aria-expanded="true"] span:nth-child(3) {
    transform: translateY(-6px) rotate(-45deg);
  }

  .site-header__mobile {
    border-top: 1px solid var(--color-rule);
    background: var(--color-bg);
  }
  .site-header__mobile ul {
    list-style: none;
    margin: 0;
    padding: 0.5rem 2.5rem 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }
  .site-header__mobile a {
    display: block;
    padding: 0.75rem 0;
    font-family: var(--font-sans);
    font-size: 0.875rem;
    font-weight: 600;
    letter-spacing: 0.125em;
    text-transform: uppercase;
    color: var(--color-fg);
    border-bottom: 1px solid var(--color-rule);
  }

  @media (max-width: 1024px) {
    .site-header { padding: 0 1.5rem; }
    .site-header__inner { padding: 1.25rem 0; }
    .site-header__menu,
    .site-header__icon-btn { display: none; }
    .site-header__hamburger { display: inline-flex; }
  }
</style>

<script>
  // Sticky shadow on scroll
  const header = document.getElementById('site-header');
  if (header) {
    const onScroll = () => {
      header.classList.toggle('is-scrolled', window.scrollY > 8);
    };
    onScroll();
    window.addEventListener('scroll', onScroll, { passive: true });
  }

  // Dark-mode toggle
  const toggle = document.getElementById('dark-mode-toggle');
  toggle?.addEventListener('click', () => {
    const root = document.documentElement;
    const isDarkNext = !root.classList.contains('dark');
    root.classList.toggle('dark', isDarkNext);
    toggle.setAttribute('aria-label', isDarkNext ? 'Activate light mode' : 'Activate dark mode');
    toggle.setAttribute('title', isDarkNext ? 'Activate light mode' : 'Activate dark mode');
    try {
      localStorage.setItem('color-mode', isDarkNext ? 'dark' : 'light');
    } catch (_) {}
  });
  // Sync aria-label on first paint with whatever the bootstrap script chose
  if (toggle) {
    const startsDark = document.documentElement.classList.contains('dark');
    toggle.setAttribute('aria-label', startsDark ? 'Activate light mode' : 'Activate dark mode');
    toggle.setAttribute('title', startsDark ? 'Activate light mode' : 'Activate dark mode');
  }

  // Copy email to clipboard
  const emailBtn = document.getElementById('copy-email');
  emailBtn?.addEventListener('click', async () => {
    const tooltip = emailBtn.querySelector<HTMLSpanElement>('.site-header__tooltip');
    try {
      await navigator.clipboard.writeText('contact@gianfaye.com');
      if (tooltip) {
        tooltip.dataset.state = 'copied';
        setTimeout(() => { tooltip.dataset.state = 'idle'; }, 1200);
      }
    } catch (_) {
      // Clipboard API unavailable — silently no-op
    }
  });

  // Mobile menu toggle
  const burger = document.getElementById('mobile-menu-toggle');
  const menu = document.getElementById('mobile-menu');
  burger?.addEventListener('click', () => {
    const open = burger.getAttribute('aria-expanded') === 'true';
    burger.setAttribute('aria-expanded', String(!open));
    burger.setAttribute('aria-label', open ? 'Open menu' : 'Close menu');
    if (menu) {
      if (open) menu.setAttribute('hidden', '');
      else menu.removeAttribute('hidden');
    }
  });
</script>
